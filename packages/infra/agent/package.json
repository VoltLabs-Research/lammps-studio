    "typia": "^12.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typia/unplugin": "^12.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
