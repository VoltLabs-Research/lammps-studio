{
  "name": "desktop",
  "productName": "LAMMPS Studio",
  "private": true,
  "version": "0.1.0",
  "description": "LAMMPS Studio for desktop",
  "author": "VoltLabs Research",
  "homepage": "https://github.com/VoltLabs-Research/lammps-studio",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "build:agent": "node scripts/agent.ts",
    "dev": "pnpm build && node scripts/dev.ts",
    "dist": "pnpm build && pnpm build:agent && pnpm --filter studio build && electron-builder",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@lammps-studio/contracts": "workspace:*",
    "@types/node": "^26.1.1",
    "@typia/unplugin": "^12.1.1",
    "electron": "44.7.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
