units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
thermo          10
minimize        1.0e-4 1.0e-6 50 500
velocity        all create 1.0 87287 loop geom
fix             1 all nve
run             40
