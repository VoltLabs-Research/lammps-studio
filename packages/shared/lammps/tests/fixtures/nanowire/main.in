# Uniaxial tension of a <100> Cu nanowire
# EAM potential: Mishin et al., PRB 63, 224106 (2001)

include         setup.lammps

variable        T      index 300
variable        erate  index 0.001      # 1/ps, i.e. 1e9 1/s
variable        seed   index 48213
variable        T      index 900
variable        L      equal 12
variable        steps  equal 400
variable        label  string "Cu wire #1"

lattice         fcc 3.615
region          box block -6 6 -6 6 0 ${L}
create_box      1 box
region          wire cylinder z 0 0 4.2 INF INF
create_atoms    1 region wire
compute         msd all msd

pair_style      eam/alloy
pair_coeff      * * potentials/Cu_mishin1.eam.alloy Cu

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

compute         pe all pe/atom
compute         cna all cna/atom 3.08

# --- equilibrate at T ----------------------------------------
velocity        all create $T ${seed} mom yes rot yes dist gaussian
fix             nvt all nvt temp ${T} ${T} 0.1
thermo          ${thermo_every}
thermo_style    custom step temp pe ke etotal press
run             ${steps}

# --- pull along z --------------------------------------------
reset_timestep  0
variable        tmp    equal lz
variable        L0     equal ${tmp}
variable        strain equal (lz-v_L0)/v_L0
variable        stress equal -pzz/10000      # GPa

fix             pull all deform 1 z erate ${erate} &
                units box remap x
thermo_style    custom step temp pe ke etotal press lz &
                v_strain v_stress

dump            traj all custom 100 wire.lammpstrj id type x y z &
                c_pe c_cna
dump_modify     traj sort id
restart         200 restart.*.cu
print           "Pulling ${label} at $T K"
run             400

write_data      final.data
